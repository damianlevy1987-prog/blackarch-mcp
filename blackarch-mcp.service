[Unit]
Description=BlackArch MCP Server
Documentation=https://blackarch.org
After=network.target

# Template: install.sh renders @BASE_DIR@ and @USER@ before installing.
[Service]
Type=simple
User=@USER@
WorkingDirectory=@BASE_DIR@
ExecStart="/usr/bin/python3" "@BASE_DIR@/blackarch_mcp_v2.py"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

Environment="BLACKARCH_DB=@BASE_DIR@/blackarch_full_db.json"
Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
